* text=auto

# Keep source and scripts consistent across macOS and Windows checkouts.
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf

# Preserve Git LFS storage and binary handling for Unreal assets.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
